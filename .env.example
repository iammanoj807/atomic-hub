# Firebase environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# The one account that can sign in (Firebase console → Authentication → Users).
# Not a secret: it ships in the bundle. The password is checked by Firebase and
# never appears in the code, and firestore.rules only admit this account's uid.
VITE_OWNER_EMAIL=you@example.com
